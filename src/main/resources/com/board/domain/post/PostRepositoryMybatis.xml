<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.board.domain.post.PostRepositoryMybatis">

    <!-- 게시물 저장: AUTO_INCREMENT ID 획득 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into post (author_id, author, title, content)
        values (#{authorId}, #{author}, #{title}, #{content})
    </insert>

    <!-- 게시물 수정 -->
    <update id="update">
        update post
        set title = #{title}, content = #{content}
        where id = #{id}
    </update>

    <!-- 작성자 이름 업데이트 (회원 정보 수정 시 연동) -->
    <update id="updateAuthor">
        update post
        set author = #{author}
        where id = #{id}
    </update>

    <!-- 게시물 삭제 -->
    <delete id="delete">
        delete from post
        where id = #{id}
    </delete>

    <!-- 전체 게시물 조회 -->
    <select id="findAll" resultType="Post">
        select id, author_id, author, title, content
        from post
    </select>

    <!-- 조건부 검색 및 페이징 조회 -->
    <select id="postSearchFindAll" resultType="Post">
        select id, author_id, author, title, content
        from post
        <where>
            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="type == 'author'">
                        and author like concat('%', #{keyword}, '%')
                    </when>
                    <when test="type == 'title'">
                        and title like concat('%', #{keyword}, '%')
                    </when>
                </choose>
            </if>
        </where>
        order by id desc
        limit #{limit} offset #{offset}
    </select>

    <!-- 검색 결과 총 개수 조회 -->
    <select id="postSearchCount" resultType="int">
        select count(*)
        from post
        <where>
            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="type == 'author'">
                        and author like concat('%', #{keyword}, '%')
                    </when>
                    <when test="type == 'title'">
                        and title like concat('%', #{keyword}, '%')
                    </when>
                </choose>
            </if>
        </where>
    </select>

    <!-- 고유 ID를 통한 단건 조회 -->
    <select id="findById" resultType="Post">
        select id, author_id, author, title, content
        from post
        where id = #{id}
    </select>

    <!-- 회원 ID별 게시물 목록 조회 -->
    <select id="findByMemberId" resultType="Post">
        select id, author_id, author, title, content
        from post
        where author_id = #{memberId}
    </select>

</mapper>
